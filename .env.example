# Copy to .env (git-ignored) and fill in what you need. Everything is optional.

# Optional: enable the LLM chat coach with your own Anthropic API key.
# Without it the chat uses the built-in rule-based coach.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: require a password. Without one, only this computer can open the app.
# APP_PASSWORD=

# Optional: pin "today" to a timezone when the server runs in a different one.
# COACH_TZ=America/New_York

# Optional: where Garmin session tokens live (default ~/.garminconnect).
# GARMINTOKENS=~/.garminconnect

# Optional: server bind. HOST=0.0.0.0 exposes it on your network and needs APP_PASSWORD.
# HOST=127.0.0.1
# PORT=8000

# Optional: extra host names to answer to when no password is set (comma-separated).
# ALLOWED_HOSTS=coach.local
